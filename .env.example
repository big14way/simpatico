# Copy to .env and fill in. Every value here is server-side only; none is sent to the browser.

# --- Qloo (required for live scoring; Simpatico refuses to score without it) ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# requests in flight at once (Qloo publishes no limits; stay conservative)
QLOO_CONCURRENCY=4

# --- Claude (bull, bear, memo writer, outreach drafter, no-Qloo ablation ranker) ---
# Scores and verdicts never come from the model. Without a key the debate is skipped and
# memos are written from the ledger template.
ANTHROPIC_API_KEY=
# default claude-opus-5-5
LLM_MODEL=
# low | medium | high | xhigh | max (default high)
LLM_EFFORT=
# server-side refusal fallbacks (default on); set to "off" to disable
LLM_FALLBACKS=
# stored answers: an identical request (model, effort, prompts, evidence) is answered from
# Postgres instead of calling the model again (default on); set to "off" to always call live
LLM_CACHE=

# --- Storage: Postgres (e.g. Neon). Leave empty to use embedded PGlite in ./.data ---
DATABASE_URL=

# --- Demo mode: live | hybrid | replay ---
#   hybrid: showcase scenarios load from the private server-side cache of recorded Qloo
#           responses; new mandates run live.
DEMO_MODE=hybrid

# --- Actions ---
# Sandbox rewrites every outreach recipient to OUTREACH_SANDBOX_INBOX. Forced on outside local dev.
OUTREACH_SANDBOX=1
OUTREACH_SANDBOX_INBOX=
RESEND_API_KEY=
RESEND_FROM=Simpatico <onboarding@resend.dev>
SLACK_WEBHOOK_URL=
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Shared secret for the weekly re-score job (GitHub Actions -> POST /api/jobs/rescore)
JOB_HMAC_SECRET=
APP_URL=http://localhost:3000
